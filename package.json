{
  "name": "smart-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A browser wrapping the Chrome engine with tag-first bookmarks.",
  "license": "MIT",
  "workspaces": [
    "apps/browser",
    "packages/*"
