{
  "name": "smart-browser",
  "version": "0.3.0",
  "private": true,
  "description": "A browser wrapping the Chrome engine with tag-first bookmarks.",
  "license": "MIT",
  "workspaces": [
    "apps/browser",
    "apps/extension",
    "packages/*"
  ],
  "scripts": {
    "lint:md": "markdownlint-cli2 \\\"**/*.md\\\" \\\"#node_modules\\\" \\\"#**/node_modules\\\" \\\"#**/.venv\\\" \\\"#**/venv\\\" \\\"#**/dist\\\" \\\"#**/.git\\\"",
    "version:check": "python3 scripts/version.py check",
    "version:set": "python3 scripts/version.py set",
    "test:ext": "node --test apps/extension/test/*.test.js"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.2"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
