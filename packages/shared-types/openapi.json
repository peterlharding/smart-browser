{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart-Browser Bookmarks API",
    "description": "Tag-first bookmarks. Contract version 1. See doc/architecture.md.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Liveness plus the two numbers a client needs to check compatibility.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookmarks": {
      "post": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Save Bookmark",
        "description": "Save a page.\n\n201 the first time, 200 every time after, never a second row \u2014 whatever the spelling\nof the URL and however many clients call at once. Tags in the payload are merged on\nevery call, so re-saving with new tags adds them rather than failing.",
        "operationId": "save_bookmark_api_v1_bookmarks_post",
        "security": [
          {
            "API token": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookmarkCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "bookmarks"
        ],
        "summary": "List Bookmarks",
        "description": "List your saves.\n\n`mode=all` is the intersection the tag sidebar is built on \u2014 `python` AND `fastapi`.\n`untagged=true` is how you work the backlog.",
        "operationId": "list_bookmarks_api_v1_bookmarks_get",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated tag names",
              "title": "Tags"
            },
            "description": "Comma-separated tag names"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "any"
              ],
              "type": "string",
              "default": "all",
              "title": "Mode"
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Site"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring match on title or URL",
              "title": "Q"
            },
            "description": "Substring match on title or URL"
          },
          {
            "name": "untagged",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only bookmarks with no tags",
              "default": false,
              "title": "Untagged"
            },
            "description": "Only bookmarks with no tags"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookmarks/lookup": {
      "get": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Lookup Bookmark",
        "description": "Have I saved this page, and with what tags?\n\nA read. `POST /bookmarks` is idempotent and would answer the same question, but it is\na write: a client calling it merely to ask would create a bookmark every time someone\nopened a popup. 404 means not saved, which is a normal answer here.",
        "operationId": "lookup_bookmark_api_v1_bookmarks_lookup_get",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Url"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookmarks/{save_id}": {
      "get": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Get Bookmark",
        "operationId": "get_bookmark_api_v1_bookmarks__save_id__get",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Save Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Patch Bookmark",
        "operationId": "patch_bookmark_api_v1_bookmarks__save_id__patch",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Save Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookmarkPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Delete Bookmark",
        "description": "Unsave a page.\n\nA soft delete of *your* save. The `bookmark` row and anything crawled for it survive,\nbecause they belong to everyone; and re-saving the page restores this row rather than\ncreating a second one.",
        "operationId": "delete_bookmark_api_v1_bookmarks__save_id__delete",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Save Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookmarks/{save_id}/tags": {
      "post": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Add Tags",
        "operationId": "add_tags_api_v1_bookmarks__save_id__tags_post",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Save Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TagsIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookmarks/{save_id}/tags/{tag_name}": {
      "delete": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Remove Tag",
        "operationId": "remove_tag_api_v1_bookmarks__save_id__tags__tag_name__delete",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "save_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Save Id"
            }
          },
          {
            "name": "tag_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tag Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tags": {
      "get": {
        "tags": [
          "tags"
        ],
        "summary": "List Tags",
        "description": "Your tags, with how often you have used them.\n\nThe vocabulary is global (ADR 0002) but the counts are yours: what belongs in an\nautocomplete list is how often *you* reach for a tag. Ranking by usage rather than\nalphabetically is what makes a 567-entry vocabulary usable at all.",
        "operationId": "list_tags_api_v1_tags_get",
        "security": [
          {
            "API token": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring match on tag name",
              "title": "Q"
            },
            "description": "Substring match on tag name"
          },
          {
            "name": "min_count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Min Count"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagOut"
                  },
                  "title": "Response List Tags Api V1 Tags Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookmarkCreate": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "The page's title as the client saw it, such as the browser tab's title. Refreshed by every save that sends one. A title you choose goes through PATCH instead, and wins over this one and over the crawled title."
          },
          "saved_from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Saved From"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "BookmarkCreate"
      },
      "BookmarkOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "site": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Site"
          },
          "saved_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Saved From"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url",
          "title",
          "site",
          "saved_from",
          "created_at",
          "tags"
        ],
        "title": "BookmarkOut"
      },
      "BookmarkPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BookmarkOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "BookmarkPage"
      },
      "BookmarkPatch": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "A title you choose. It wins over the title seen at save time and the crawled one, and survives every re-save. An empty string clears it."
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tags"
          }
        },
        "type": "object",
        "title": "BookmarkPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "contract": {
            "type": "integer",
            "title": "Contract"
          },
          "schema_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Revision"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "version",
          "contract"
        ],
        "title": "Health",
        "description": "What a client needs to decide whether it can talk to this deployment.\n\n`contract` is the one to check: it is the API contract version, independent of\n`version`, which is the release label and moves every deploy."
      },
      "TagOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "count"
        ],
        "title": "TagOut"
      },
      "TagsIn": {
        "properties": {
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Tags"
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "ai",
              "rule",
              "import"
            ],
            "title": "Source",
            "default": "user"
          }
        },
        "type": "object",
        "required": [
          "tags"
        ],
        "title": "TagsIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "API token": {
        "type": "http",
        "description": "The token half of an API_TOKENS entry: for `plh:s3cret`, enter `s3cret`.",
        "scheme": "bearer"
      }
    }
  }
}
