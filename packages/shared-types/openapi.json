{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart-Browser Bookmarks API",
    "description": "Tag-first bookmarks. Contract version 2. See doc/architecture.md.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v2/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Liveness plus the two numbers a client needs to check compatibility.",
        "operationId": "health_api_v2_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/bookmarks": {
      "post": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Create Bookmark",
        "description": "Save a page. Idempotent on the URL.\n\nReturns 200 when the bookmark already existed, 201 when it was created. Either way\nany tags in the payload are attached, so re-saving with new tags is an upsert of\ntags rather than an error.",
        "operationId": "create_bookmark_api_v2_bookmarks_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookmarkCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "bookmarks"
        ],
        "summary": "List Bookmarks",
        "description": "List bookmarks.\n\n`mode=all` is the intersection query the tag sidebar is built on -- `python` AND\n`fastapi`, not `python` OR `fastapi`. `untagged=true` is how you work the 7,655-row\nbacklog the audit found.",
        "operationId": "list_bookmarks_api_v2_bookmarks_get",
        "parameters": [
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated tag names",
              "title": "Tags"
            },
            "description": "Comma-separated tag names"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "any"
              ],
              "type": "string",
              "default": "all",
              "title": "Mode"
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Site"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring match on title or URL",
              "title": "Q"
            },
            "description": "Substring match on title or URL"
          },
          {
            "name": "untagged",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only bookmarks with no tags",
              "default": false,
              "title": "Untagged"
            },
            "description": "Only bookmarks with no tags"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/bookmarks/{bookmark_id}": {
      "get": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Get Bookmark",
        "operationId": "get_bookmark_api_v2_bookmarks__bookmark_id__get",
        "parameters": [
          {
            "name": "bookmark_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Bookmark Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Patch Bookmark",
        "operationId": "patch_bookmark_api_v2_bookmarks__bookmark_id__patch",
        "parameters": [
          {
            "name": "bookmark_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Bookmark Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookmarkPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Delete Bookmark",
        "description": "Delete a bookmark and its tag links.\n\nWARNING: this is a hard delete. The target schema has `deleted_at` and this becomes\na soft delete at M2; until then there is no undo, so the browser should not wire a\none-keystroke delete to this endpoint yet.",
        "operationId": "delete_bookmark_api_v2_bookmarks__bookmark_id__delete",
        "parameters": [
          {
            "name": "bookmark_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Bookmark Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/bookmarks/{bookmark_id}/tags": {
      "post": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Add Tags",
        "description": "Attach tags.\n\n`source` is accepted and currently discarded: the column arrives in M2. It is in the\ncontract now so the browser and the categoriser can be written against the final\nshape and need no change when the column lands.",
        "operationId": "add_tags_api_v2_bookmarks__bookmark_id__tags_post",
        "parameters": [
          {
            "name": "bookmark_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Bookmark Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TagsIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/bookmarks/{bookmark_id}/tags/{tag_name}": {
      "delete": {
        "tags": [
          "bookmarks"
        ],
        "summary": "Remove Tag",
        "operationId": "remove_tag_api_v2_bookmarks__bookmark_id__tags__tag_name__delete",
        "parameters": [
          {
            "name": "bookmark_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Bookmark Id"
            }
          },
          {
            "name": "tag_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tag Name"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/tags": {
      "get": {
        "tags": [
          "tags"
        ],
        "summary": "List Tags",
        "description": "Tags with usage counts.\n\nCounts matter more than the names here: the audit found 10 tags never used and one\nblank tag on 43 bookmarks, and the browser's sidebar needs to rank by usage rather\nthan list 567 entries alphabetically.",
        "operationId": "list_tags_api_v2_tags_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Substring match on tag name",
              "title": "Q"
            },
            "description": "Substring match on tag name"
          },
          {
            "name": "min_count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Min Count"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagOut"
                  },
                  "title": "Response List Tags Api V2 Tags Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookmarkCreate": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "saved_from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Saved From"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "BookmarkCreate"
      },
      "BookmarkOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "site": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Site"
          },
          "saved_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Saved From"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url",
          "title",
          "site",
          "saved_from",
          "created_at",
          "tags"
        ],
        "title": "BookmarkOut"
      },
      "BookmarkPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BookmarkOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "BookmarkPage"
      },
      "BookmarkPatch": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tags"
          }
        },
        "type": "object",
        "title": "BookmarkPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "contract": {
            "type": "integer",
            "title": "Contract"
          },
          "schema_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Revision"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "version",
          "contract"
        ],
        "title": "Health",
        "description": "What a client needs to decide whether it can talk to this deployment.\n\n`contract` is the one to check: it is the API contract version, independent of\n`version`, which is the release label and moves every deploy."
      },
      "TagOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "count"
        ],
        "title": "TagOut"
      },
      "TagsIn": {
        "properties": {
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Tags"
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "ai",
              "rule",
              "import"
            ],
            "title": "Source",
            "default": "user"
          }
        },
        "type": "object",
        "required": [
          "tags"
        ],
        "title": "TagsIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
