{
  "manifest_version": 3,
  "name": "Smart-Browser Bookmarks",
  "version": "0.3.0",
  "description": "Save the current tab with tags, straight into your bookmarks database.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Save with tags"
  },
  "options_page": "options/options.html",
  "permissions": ["tabs", "activeTab", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+B", "mac": "Command+Shift+B" },
      "description": "Save the current tab, with tags"
    },
    "quick-save": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current tab immediately, without tagging"
    }
  }
}
