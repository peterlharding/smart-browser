# Template for this project's .env.
#
# Copy it to the repo root (shared by the whole monorepo) or to apps/api/ (API only).
# Both are read, by absolute path, with apps/api/.env overriding the root one and
# real environment variables beating both. Neither is committed.
# Database ------------------------------------------------------------------
# DB_USER is not optional. Left empty, libpq falls back to the operating-system user,
# and since Postgres assigns table ownership to whoever runs CREATE TABLE, migrations
# would silently leave every table owned by the wrong role. The API refuses to build a
# connection URL without it.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=page_history
DB_USER=api
DB_PASSWORD=

# Schema guard --------------------------------------------------------------
# The API refuses to start when the database is not at the Alembic revision this code
# requires. Setting this false is a deliberate act for a known situation, not a default.
# SCHEMA_CHECK=true

# API -----------------------------------------------------------------------
# Comma-separated client tokens accepted on writes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=

# M0 only. The pre-migration schema has no ownership columns, so every request acts as
# this identity. M1 adds app_user + OAuth and this goes away.
SINGLE_USER_ID=plh

# Extra browser origins allowed to call the API, comma-separated. Extension pages are
# already matched by pattern (chrome-extension://... / moz-extension://...), so this is
# only for something else -- a dev server, say. Leave empty otherwise.
CORS_ORIGINS=

# Embeddings ----------------------------------------------------------------
# The crawl worker refuses loopback, link-local and private-network addresses, at every
# redirect (ADR 0012). true only for a deployment that wants its intranet pages crawled.
CRAWL_ALLOW_PRIVATE=false

# The embedding model, as fastembed names it, and where it is downloaded to once (64 MB).
# Its dimension must match the vector(384) column; `make embed` checks (ADR 0013).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=~/.cache/smart-browser/models

# OAuth (M1) ----------------------------------------------------------------
# The BACKEND is the confidential client -- these secrets never reach the Electron app.
# Callback URLs registered with each provider point here, not at a loopback address.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=https://example.com
# JWT_SIGNING_KEY=
